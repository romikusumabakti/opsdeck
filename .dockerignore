# VCS
.git
.gitignore

# Dependencies & build output (rebuilt inside the image)
node_modules
dist

# Secrets & local env — must never enter the image
.env
.env.*
!.env.example

# Tooling / caches not needed at build time
.claude
.github
# NOTE: do not ignore `docs` — the build stage inlines docs/time-mocking-api.md
# into the mock-time page (Vite `?raw`). The runtime image does not need it.
tests
# Source PNGs for scripts/build-motifs.mjs only; never needed by the image.
design
*.tsbuildinfo
README.md
