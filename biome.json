{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!.bun",
      "!node_modules",
      "!build",
      "!out",
      "!next-env.d.ts",
      "!tsconfig.tsbuildinfo",
      "!components/ui",
      "!drizzle",
      "!public",
      "!web/routeTree.gen.ts",
      "!dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off"
      },
      "complexity": {
        "noBannedTypes": "warn"
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["web/**", "components/**", "hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/server/app": {
                    "allowImportNames": ["AppType"],
                    "message": "Only `import type { AppType }` may come from the server app; the app itself is server code."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "@/server/**",
                      "**/server/**",
                      "!@/server/app",
                      "@/lib/db",
                      "@/lib/db/**",
                      "!@/lib/db/schema",
                      "@/lib/auth",
                      "@/lib/auth-session",
                      "@/lib/authz",
                      "@/lib/secrets",
                      "@/lib/ssh",
                      "@/lib/jobs/**"
                    ],
                    "message": "Server-only module: the browser bundle must not import it. Call the API through @/web/api/* instead."
                  },
                  {
                    "group": ["@/lib/db/schema"],
                    "importNamePattern": "[a-z].*|\\*",
                    "message": "Only the schema's row types (PascalCase) may be imported here; its tables and enums are server code."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
