.claude/settings.local.json

# Runtime lock (per-session, not team config)
.claude/scheduled_tasks.lock

# superpowers brainstorming companion
.superpowers/

# git worktrees for isolated feature work
.worktrees/

# playwright
/playwright-report/
/test-results/
/e2e/.auth/
