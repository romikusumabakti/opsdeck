# Copy to `.env` (Docker Compose) or `.env.local` (host `next dev`) and fill in.

# --- Database ---
# Used by the `postgres` service in compose.yaml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=opsdeck

# App connection string. With Compose, host is `postgres`; on the host, `localhost`.
DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/opsdeck

# --- Secrets at rest ---
# Master key for AES-256-GCM encryption of stored credentials (SSH/DB passwords,
# S3 secret keys, mock-time API keys — see lib/secrets.ts). REQUIRED to create or
# edit any server / environment / S3 connection. Generate once:
#   openssl rand -base64 32
# Rotating this key strands existing ciphertext — re-enter secrets after a change.
SECRETS_KEY=CHANGE_ME

# --- Timezone ---
# IANA timezone name. Applies to all date/time displays in the app.
# Defaults to Asia/Jakarta if unset.
APP_TIMEZONE=Asia/Jakarta

# --- Whitelabel branding (baked into client bundle at build time) ---
NEXT_PUBLIC_APP_NAME="OpsDeck"
NEXT_PUBLIC_COMPANY_NAME="Your Company"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=example.com

# --- Reverse proxy (Caddy) ---
# Hostname the public edge serves. Use a bare host (no scheme), e.g. panel.example.com.
SITE_ADDRESS=localhost

# --- Auth (better-auth) ---
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME

# --- Sign in with Microsoft (Azure Entra ID) — optional ---
# Leave all three blank to hide the button. Setting some but not all of them is
# a startup error: without a tenant id, better-auth falls back to the "common"
# authority and would accept ANY Microsoft account.
#
# In the Azure portal (Entra ID > App registrations > your app):
#   MICROSOFT_CLIENT_ID     = Application (client) ID
#   MICROSOFT_TENANT_ID     = Directory (tenant) ID
#   MICROSOFT_CLIENT_SECRET = Certificates & secrets > New client secret (VALUE,
#                             not the Secret ID). Secrets expire — note the date.
# Register this redirect URI (Authentication > Web > Redirect URIs):
#   <BETTER_AUTH_URL>/api/auth/callback/microsoft
# Also add the optional `email` claim (Token configuration) if your directory
# users have no `mail` attribute — sign-in fails without an email claim.
#
# Microsoft sign-in self-provisions: whoever Entra lets through gets an account
# on first sign-in, so gate access in Entra (Enterprise applications >
# Properties > "Assignment required" = Yes, then assign a group). App-side,
# emails outside NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN are rejected and new users
# land on the read-only `viewer` role. See docs/microsoft-sign-in.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Email (Resend) — optional; email features disabled if empty ---
RESEND_API_KEY=
# Defaults to `<APP_NAME> <no-reply@ALLOWED_EMAIL_DOMAIN>` when unset.
EMAIL_FROM=

# --- Background jobs (BullMQ) ---
# The app runs an in-process BullMQ worker (started via Next's instrumentation
# hook) that drains the task queue from Valkey. Valkey is Redis-compatible.
# With Compose, host is `valkey`; on the host (`next dev`), `localhost` — but
# Valkey publishes no host port by default, so background jobs only run in the
# Compose stack. Unset REDIS_URL disables the worker (the app still boots).
REDIS_URL=redis://valkey:6379

# --- Object storage (Garage) — knowledge-base image attachments ---
# Garage server secrets (compose `garage` service). Generate once:
#   GARAGE_RPC_SECRET:  openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN: openssl rand -base64 32
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
#
# App S3 client. ENDPOINT is the in-network Garage S3 API; on the host use
# http://localhost:3900. ACCESS/SECRET are created once via the garage CLI
# AFTER first boot (see README "Object storage setup") — leave them blank on the
# initial `docker compose up`, then fill them in and restart the app. The stack
# boots fine without them; only image uploads need them.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=knowledge
S3_ACCESS_KEY=
S3_SECRET_KEY=
#
# Image processing (imgproxy). Resizing/format conversion happens on read in a
# dedicated container — the app ships no native image lib. KEY/SALT sign the
# URLs the app mints; both the app and the imgproxy service read them. Generate:
#   IMGPROXY_KEY:  openssl rand -hex 32
#   IMGPROXY_SALT: openssl rand -hex 32
IMGPROXY_URL=http://imgproxy:8080
IMGPROXY_KEY=CHANGE_ME
IMGPROXY_SALT=CHANGE_ME
