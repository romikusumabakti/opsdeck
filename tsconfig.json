{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    // Imports must say `import type` when they mean a type. The Biome rule
    // useImportType already asks for this; this makes the compiler enforce it,
    // so an accidental value import can't drag a server-only module (and its
    // postgres driver) into a client bundle.
    "verbatimModuleSyntax": true,
    // `arr[i]` and `record[key]` are typed `T | undefined`. Costs a check at
    // every genuinely-unbounded lookup (parsing remote Jira payloads, indexing
    // by user input) and is why lib/db/one.ts exists for the cases where a row
    // really is guaranteed.
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "dist"]
}
