# Public edge for opsdeck. Caddy reverse-proxies to the app container over the
# compose network. Serves plain HTTP — no TLS.
#
# WARNING: HTTP only. Login credentials and session cookies travel in plaintext.
# Acceptable only on a trusted LAN. The served hostname comes from the SITE_ADDRESS
# env var (see .env.example); it defaults to `localhost`. If that host is a private,
# unregistered domain, a browser-trusted cert isn't obtainable for it, so TLS is
# dropped here by choice to avoid per-device CA installs. To re-enable HTTPS, point
# SITE_ADDRESS at a publicly-owned hostname and use Let's Encrypt DNS-01, or use
# `tls internal` and trust Caddy's root CA on every client.
#
# The `http://` prefix disables Caddy's automatic HTTPS (no TLS, no 80->443
# redirect); Caddy listens on :80 only.
http://{$SITE_ADDRESS:localhost} {
	# WebSocket terminal sessions live in their own process (see compose.yaml).
	# Caddy proxies WebSockets natively — no special upgrade config needed.
	handle /ws/terminal* {
		reverse_proxy terminal:3001
	}

	handle {
		reverse_proxy app:3000 {
			# Next standalone doesn't trust X-Forwarded-* for nextUrl, so next-intl's
			# absolute locale redirects leak the internal listen port (:3000) into the
			# Location header. Strip it on the way back out.
			header_down Location ":3000/" "/"
		}
	}
}
