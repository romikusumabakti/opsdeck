{
  "name": "opsdeck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "build:ops": "bun build scripts/cli.ts scripts/deploy-app.ts scripts/encrypt-legacy-secrets.ts scripts/backfill-build-actors.ts --target=bun --define process.env.NODE_ENV=process.env.NODE_ENV --outdir dist --entry-naming [name].[ext]",
    "build": "vite build && bun run build:ops && bun build server/index.ts --target=bun --define process.env.NODE_ENV=process.env.NODE_ENV --outdir dist/server && bun build lib/terminal/main.ts --target=bun --define process.env.NODE_ENV=process.env.NODE_ENV --outdir dist --entry-naming terminal-server.[ext]",
    "start": "bun dist/server/index.js",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "vite",
    "terminal": "bun run lib/terminal/main.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/cli.ts migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/lib-storage": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.20",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^7.0.5",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-code-block-lowlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "anser": "^2.3.5",
    "better-auth": "^1.7.20",
    "bullmq": "^6.7.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.5.2",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.5",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.18",
    "ioredis": "^6.0.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.72.0",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-email": "^6.11.11",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.38.0",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "tar-stream": "^3.2.2",
    "use-intl": "^4.15.0",
